/* General page styling */
body {
    font-family: Arial, Helvetica, sans-serif;
    background: linear-gradient(135deg, #f5f5f5, #e2e2e2);
    color: #222;
    text-align: center;
    margin: 0;
    padding: 30px 20px;
}

/* Main heading */
h1 {
    background: linear-gradient(135deg, #AA0000, #750000);
    color: #FFFFFF;
    padding: 35px 20px;
    margin: -30px -20px 30px;
    font-size: 38px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: 6px solid #B3995D;
    box-shadow: 0 4px 12px #00000030;
}

/* Section headings */
h2 {
    color: #AA0000;
    font-size: 27px;
    margin-top: 35px;
    text-transform: uppercase;
}

/* Team image */
img {
    width: 280px;
    max-width: 90%;
    border: 5px solid #B3995D;
    border-radius: 15px;
    box-shadow: 0 8px 20px #00000025;
    transition: transform 0.3s, box-shadow 0.3s;
}

img:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 25px #00000040;
}

/* Paragraphs */
p {
    max-width: 700px;
    margin: 18px auto;
    font-size: 18px;
    line-height: 1.8;
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 3px 10px #00000010;
}

/* Navigation menu */
nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

nav li {
    margin: 5px;
}

/* Navigation links */
nav a {
    display: inline-block;
    background-color: #AA0000;
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 14px 22px;
    border-radius: 8px;
    border: 2px solid #AA0000;
    transition: all 0.3s ease;
}

nav a:hover {
    background-color: #B3995D;
    color: #222;
    border-color: #B3995D;
    transform: translateY(-3px);
    box-shadow: 0 5px 12px #00000025;
}

/* Mobile-friendly adjustments */
@media (max-width: 600px) {
    h1 {
        font-size: 28px;
        letter-spacing: 1px;
    }

    h2 {
        font-size: 23px;
    }

    p {
        font-size: 16px;
        padding: 15px;
    }

    nav ul {
        flex-direction: column;
        align-items: center;
    }

    nav a {
        width: 200px;
    }
}